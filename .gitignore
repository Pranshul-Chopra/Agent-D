# ==============================================================================
# Agent-D — Git Ignore Specification
# ==============================================================================

# ── Python & Bytecode ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
env/
venv/
.venv/
venv311/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Test & Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
test_data/
test_output/
*.cover

# ── Node.js / Electron / Frontend ─────────────────────────────────────────────
node_modules/
electron/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Compiled frontend bundle (regenerated via `npm run build:ui`)
static/spa/
electron/dist/
electron/out/
out/

# ── Local SQLite Databases & Encryption Keys ──────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.agentd/
test_db/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.cert
token.txt

# ── Packaging & Binary Artifacts ──────────────────────────────────────────────
release/
electron/release/
*.exe
*.msi
*.dmg
*.app
*.deb
*.rpm
*.zip
*.tar.gz
flask_dist/

# ── IDEs, Editors & OS Files ──────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Temporary & Log Files ─────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
*~
